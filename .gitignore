# Environment / secrets — never commit real keys
.env
.env.*
!.env.example
!**/.env.example
backend/.env
frontend/.env
**/.env
!**/.env.example
*.pem
credentials.json
.secrets/

# Python
__pycache__/
*.py[cod]
.venv/
backend/.venv/

# Node
node_modules/
frontend/node_modules/
frontend/.next/

# Vendored Atlas clone (local only; tokens/primitives copied into frontend/)
.atlas-vendor-tmp/

# Logs & runtime artifacts
*.log
backend.log
frontend.log
.playwright-mcp/
.run/

# OS
.DS_Store

# Build & runtime temp (GUI .app may not inherit a writable system TMPDIR)
.run/tmp/
**/.claude/settings.local.json
